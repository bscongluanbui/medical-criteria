# Generate each token/password independently; never commit .env.
POSTGRES_PASSWORD=
READER_TOKEN=
REVIEWER_TOKEN=
ADMIN_TOKEN=
APP_IMAGE=ghcr.io/bscongluanbui/medical-criteria:latest
API_PORT=8001
DASHBOARD_PORT=3500
DASHBOARD_ORIGIN=https://criteria.bcanatomy.site
CRITERIA_ROOT=/home/ubuntu/criteria
CRITERIA_DRIVE_ROOT=/home/ubuntu/rclone/papers/criteria_sources
LIBRARY_SCAN_INTERVAL=900
DRIVE_SYNC_INTERVAL=60
DRIVE_AUTO_PREPARE=true

# Optional automation: set COMPOSE_PROFILES=drive,bot after filling these values.
# Public Telegram bot: no user/chat ID allowlist.
TELEGRAM_BOT_TOKEN=
# Base URL only, do not append /chat/completions. HTTP or HTTPS.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_MODEL=
AI_JSON_MODE=true
AI_MAX_OUTPUT_TOKENS=12000
# Cost controls apply only to NEW research, not existing-card lookups.
AI_DAILY_JOB_LIMIT=20
AI_CHAT_COOLDOWN_SECONDS=60

# Optional query routing model; empty uses AI_MODEL
AI_ROUTER_MODEL=
