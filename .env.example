# Generate each token/password independently; never commit .env.
POSTGRES_PASSWORD=
READER_TOKEN=
REVIEWER_TOKEN=
ADMIN_TOKEN=
APP_IMAGE=ghcr.io/bscongluanbui/medical-criteria:latest
API_PORT=8001
DASHBOARD_PORT=3500
